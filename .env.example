# PUB400 (the public IBM i this project runs on) - used by api/ and tools/spike_svc.py
PUB400_USER=<your PUB400 user>
PUB400_PASS=<your PUB400 password>
PUB400_LIB=ARNAV27122
# How the API reaches IBM i: blank = through the SSH tunnel (default, encrypted by SSH),
# plain = straight to the host on 8471 (UNENCRYPTED), tls = straight to the host on 9471 with SSL=1.
PUB400_DIRECT=
PUB400_HOST=<PUB400 host name, only for the direct modes>
